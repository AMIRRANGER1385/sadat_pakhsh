# Copy this file to .env ON THE HOST only; replace CPANEL_USER with your actual account name.
NODE_ENV="production"
APP_URL="https://sadatpakhsh.ir"
DATABASE_URL="file:/home/CPANEL_USER/naylex-data/shop.db"
UPLOAD_DIR="/home/CPANEL_USER/naylex-data/uploads"
ADMIN_USERNAME="admin"
# Create a new strong password (12+ characters, no more than 72 UTF-8 bytes).
ADMIN_PASSWORD=""
ZARINPAL_MERCHANT_ID=""
# Test first; change to false only after gateway activation and verification.
ZARINPAL_SANDBOX="true"
