Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
# Keep one crawlable origin. HSTS does not redirect the first plain-HTTP visit.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://sadatpakhsh.ir%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^(?:\.git|\.env|naylex-app|storage)(?:/|$) - [F,L,NC]
# /products is both a storefront route and an image directory.
# Route the directory URL through PHP before the existing-directory check.
RewriteRule ^products/?$ index.php [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "(?i)(^\.|\.(?:sql|ini|log|bak|zip|env)$)">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(?:css|js|woff2)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(?:png|jpe?g|webp|avif|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
